{
  "name": "villa - Vesuvius Challenge dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteEnv": { "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  }
}
